# ==============================================================================
# PT TelkoNusa Digital — Shared Environment Configuration
# Salin file ini menjadi .env sebelum menjalankan aplikasi.
# ==============================================================================

# MySQL 8.0 Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=telconusa_root
MYSQL_USER=telconusa
MYSQL_PASSWORD=telconusa123

# Database URLs per Division (Satu Data, Satu Pemilik)
CRM_DATABASE_URL=mysql+pymysql://telconusa:telconusa123@localhost:3306/telconusa_crm
HRM_DATABASE_URL=mysql+pymysql://telconusa:telconusa123@localhost:3306/telconusa_hrm
SCM_DATABASE_URL=mysql+pymysql://telconusa:telconusa123@localhost:3306/telconusa_scm
FINANCE_DATABASE_URL=mysql+pymysql://telconusa:telconusa123@localhost:3306/telconusa_finance

# Security & Inter-Service Auth
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
HMAC_WEBHOOK_SECRET=change-this-hmac-webhook-secret

# Event Bus Mode: "rabbitmq" (default via Docker) atau "webhook" (tanpa RabbitMQ)
EVENT_TRANSPORT=rabbitmq
RABBITMQ_URL=amqp://telconusa:telconusa123@localhost:5672/

# Service Base URLs (Internal Inter-Service Calls)
CRM_API_URL=http://localhost:8001
HRM_API_URL=http://localhost:8002
SCM_API_URL=http://localhost:8003
FINANCE_API_URL=http://localhost:8004

# Next.js Public API URLs (Browser)
NEXT_PUBLIC_CRM_API_URL=http://localhost:8001
NEXT_PUBLIC_HRM_API_URL=http://localhost:8002
NEXT_PUBLIC_SCM_API_URL=http://localhost:8003
NEXT_PUBLIC_FINANCE_API_URL=http://localhost:8004

# Business Simulation Parameters (Sesuai Variable Standards)
PPN_RATE=0.11
REFERRAL_INCENTIVE_RATE=0.10
REFERRAL_KPI_POINTS=10
RESERVATION_TTL_HOURS=72
